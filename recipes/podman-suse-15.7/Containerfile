# Versions and checksums are ARGs, declared right before their first use.
# Changing one only rebuilds the layers from there on. Override them for one build with, e.g.
#     ./build.sh --build-arg MPICH_RELEASE=5.0.3 --build-arg MPICH_SHA256=...
# Library paths go to /etc/ld.so.conf.d instead of LD_LIBRARY_PATH.
# The ld.so cache works in Podman and Singularity alike, and Singularity keeps /.singularity.d/libs first in LD_LIBRARY_PATH.
# Sources are built in /tmp/build. They stay in the intermediate layers of the archive, but not in the flattened SIF.

ARG SUSE_BASE_IMAGE=registry.suse.com/bci/gcc:15@sha256:1997398d083d39594ec668bb2ee1d7593a5483baf10ac78602985d6fe86cf671
FROM ${SUSE_BASE_IMAGE}

#################################################################################
# Repositories and system packages

# Dependencies for fetching keys
RUN zypper --non-interactive install wget

# Fetch, check, and import signing keys
WORKDIR /tmp/keys
ARG OPENSUSE_SP=15.7
ARG CLUSTER_KEY_SHA256=d546e147623ed42fd2c22f0791e97819d5d65c35bdce92d69f0218ebbaf98984
RUN wget --output-document=cluster.key https://download.opensuse.org/repositories/network:cluster/$OPENSUSE_SP/repodata/repomd.xml.key
RUN echo "$CLUSTER_KEY_SHA256  cluster.key" | sha256sum --check --strict
RUN rpm --import cluster.key

ARG AMD_KEY_SHA256=090a4bf906822c5eb450ae8024b728b9281f2fccb0304641eb75018e4ec6a6dd
RUN wget --output-document=amd.key https://repo.amd.com/rocm/packages-multi-arch/gpg/rocm.gpg
RUN echo "$AMD_KEY_SHA256  amd.key" | sha256sum --check --strict
RUN rpm --import amd.key

# Add repositories
ARG ROCM_SLES_VER=sles15
RUN zypper --non-interactive addrepo --gpgcheck-strict https://download.opensuse.org/repositories/network:cluster/$OPENSUSE_SP network-cluster
RUN zypper --non-interactive addrepo --gpgcheck-strict https://repo.amd.com/rocm/packages-multi-arch/$ROCM_SLES_VER/x86_64 rocm
RUN zypper --non-interactive refresh

# Dependencies
RUN zypper --non-interactive install \
        cmake \
        hwloc \
        hwloc-devel \
        bzip2 \
        autoconf \
        automake \
        libtool \
        pkg-config \
        libjson-c-devel \
        libnl3-devel \
        libcurl-devel \
        libconfig-devel \
        libuv-devel \
        fuse-devel \
        libyaml-devel \
        libsensors4-devel \
        libnuma-devel \
        python3

#################################################################################
# ROCm

ARG ROCM_RELEASE=7.14
ARG ROCM_ARCH=gfx90a
RUN zypper --non-interactive install amdrocm-core-devel$ROCM_RELEASE-$ROCM_ARCH
RUN echo /opt/rocm/core-$ROCM_RELEASE/lib > /etc/ld.so.conf.d/rocm.conf && ldconfig

ENV ROCM_PATH=/opt/rocm/core-${ROCM_RELEASE}
ENV PATH=/opt/rocm/core-${ROCM_RELEASE}/bin:${PATH}

#################################################################################
# Network stack

# Compilers of the base image. Build arguments are visible as environment variables in RUN.
ARG CC=gcc-15
ARG CXX=g++-15
ARG FC=gfortran-15
ARG F77=gfortran-15

## CXI driver headers
WORKDIR /tmp/build/cxi-driver
ARG SHS_RELEASE=12.0.2
ARG CXI_DRIVER_SHA256=9d10c8783b64844303651afa9f9500a9a86918827446d469797925340f9c7ec7
RUN wget --output-document=shs-cxi-driver.tar.gz https://github.com/HewlettPackard/shs-cxi-driver/archive/refs/tags/release/shs-$SHS_RELEASE.tar.gz
RUN echo "$CXI_DRIVER_SHA256  shs-cxi-driver.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=shs-cxi-driver.tar.gz --strip-components=1
RUN mkdir -p /opt/libcxi/include
RUN cp -r include/* /opt/libcxi/include

## Cassini headers
# The libcxi build below expects the Cassini headers in ../cassini-headers/install relative to its source directory
WORKDIR /tmp/build/cassini-headers/install
ARG CASSINI_SHA256=478a7bed6eedae6ba7035e7a0fc5662689f3d6dcffce27533e0a4ae1d35727b2
RUN wget --output-document=shs-cassini.tar.gz https://github.com/HewlettPackard/shs-cassini-headers/archive/refs/tags/release/shs-$SHS_RELEASE.tar.gz
RUN echo "$CASSINI_SHA256  shs-cassini.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=shs-cassini.tar.gz --strip-components=1
RUN cp -r include/* /opt/libcxi/include

## libcxi
WORKDIR /tmp/build/libcxi
ARG LIBCXI_SHA256=339d3e88671c1283cb4da214a86ad80ff3a8ac39a43912e63486fb8dab44b08e
RUN wget --output-document=libcxi.tar.gz https://github.com/HewlettPackard/shs-libcxi/archive/refs/tags/release/shs-$SHS_RELEASE.tar.gz
RUN echo "$LIBCXI_SHA256  libcxi.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=libcxi.tar.gz --strip-components=1
RUN ./autogen.sh
RUN ./configure \
        CPPFLAGS="-I/opt/rocm/core-$ROCM_RELEASE/include -D __HIP_PLATFORM_HCC__ -D __HIP_PLATFORM_AMD__ -D HAVE_HIP_SUPPORT" \
        CFLAGS="-I/opt/libcxi/include" \
        --prefix=/opt/libcxi \
        --with-rocm=/opt/rocm/core-$ROCM_RELEASE \
        --with-systemdsystemunitdir=/opt/libcxi/lib/systemd \
        --with-udevrulesdir=/opt/libcxi/lib/udev
RUN make --jobs=$(nproc) install
RUN echo /opt/libcxi/lib > /etc/ld.so.conf.d/libcxi.conf && ldconfig

## KDREG2 headers, used by the libfabric build
WORKDIR /tmp/build/kdreg2
ARG KDREG2_SHA256=d58b93e059e18dd96a4a5d7e99afbe650848cec954fdbbb1a031308246d0d212
RUN wget --output-document=shs-kdreg2.tar.gz https://github.com/HewlettPackard/shs-kdreg2/archive/refs/tags/release/shs-$SHS_RELEASE.tar.gz
RUN echo "$KDREG2_SHA256  shs-kdreg2.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=shs-kdreg2.tar.gz --strip-components=1

## libfabric
WORKDIR /tmp/build/libfabric
ARG LIBFABRIC_RELEASE=2.7.0
ARG LIBFABRIC_SHA256=366000427e194d4ce22e272519b608afbebb1fc9915bcf5da924157a8a47fe10
RUN wget --output-document=libfabric.tar.bz2 https://github.com/ofiwg/libfabric/releases/download/v$LIBFABRIC_RELEASE/libfabric-$LIBFABRIC_RELEASE.tar.bz2
RUN echo "$LIBFABRIC_SHA256  libfabric.tar.bz2" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=libfabric.tar.bz2 --strip-components=1
RUN ./configure \
        CFLAGS="-g -O -Wno-error=maybe-uninitialized" \
        CPPFLAGS="-I/opt/libcxi/include -I/opt/rocm/core-$ROCM_RELEASE/include" \
        LDFLAGS="-L/opt/rocm/core-$ROCM_RELEASE/lib" \
        PKG_CONFIG_PATH=/opt/libcxi/lib/pkgconfig \
        --prefix=/opt/libfabric \
        --enable-cxi=/opt/libcxi \
        --with-rocr=/opt/rocm/core-$ROCM_RELEASE \
        --with-kdreg2=/tmp/build/kdreg2/include \
        --with-default-monitor=kdreg2 \
        --disable-sockets --disable-udp --disable-verbs --disable-rxm --disable-mrail --disable-rxd --disable-tcp \
        --disable-usnic --disable-efa --disable-psm2 --disable-psm3 --disable-opx --disable-lnx
RUN make --jobs=$(nproc) install
RUN echo /opt/libfabric/lib > /etc/ld.so.conf.d/libfabric.conf && ldconfig

## MPICH
WORKDIR /tmp/build/mpich
ARG MPICH_RELEASE=5.0.2
ARG MPICH_SHA256=928c2f18d350a91443fe8024ad01ce2c6009e9c551e0a73e797fc567f119137d
RUN wget --output-document=mpich.tar.gz https://www.mpich.org/static/downloads/$MPICH_RELEASE/mpich-$MPICH_RELEASE.tar.gz
RUN echo "$MPICH_SHA256  mpich.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=mpich.tar.gz --strip-components=1
# The bundled yaksa uses ATOMIC_VAR_INIT, which C23 (the default of GCC 15) removed. MPICHLIB_CFLAGS stays out of the mpicc wrapper.
RUN ./configure \
        MPICHLIB_CFLAGS="-std=gnu17" \
        --prefix=/opt/mpich \
        --with-device=ch4:ofi \
        --with-libfabric=/opt/libfabric \
        --with-hip-include=/opt/rocm/core-$ROCM_RELEASE/include \
        --with-hip-lib=/opt/rocm/core-$ROCM_RELEASE/lib \
        --with-hwloc=/usr
RUN make --jobs=$(nproc) install
RUN echo /opt/mpich/lib > /etc/ld.so.conf.d/mpich.conf && ldconfig

## aws-ofi-nccl
WORKDIR /tmp/build/aws-ofi-nccl
ARG AWS_OFI_NCCL_RELEASE=1.22.0
ARG AWS_OFI_NCCL_SHA256=c791bd33b73c089bd37e314c8e7c551a5247e3feee53f077e0835daf730db09a
RUN wget --output-document=aws-ofi-nccl.tar.gz https://github.com/aws/aws-ofi-nccl/releases/download/v$AWS_OFI_NCCL_RELEASE/aws-ofi-nccl-$AWS_OFI_NCCL_RELEASE.tar.gz
RUN echo "$AWS_OFI_NCCL_SHA256  aws-ofi-nccl.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=aws-ofi-nccl.tar.gz --strip-components=1
RUN ./configure \
        --prefix=/opt/aws-ofi-nccl \
        --with-libfabric=/opt/libfabric \
        --with-rocm=/opt/rocm/core-$ROCM_RELEASE \
        --with-mpi=/opt/mpich
RUN make --jobs=$(nproc) install
RUN echo /opt/aws-ofi-nccl/lib > /etc/ld.so.conf.d/aws-ofi-nccl.conf && ldconfig

ENV PATH=/opt/mpich/bin:/opt/libfabric/bin:${PATH}
ENV PKG_CONFIG_PATH=/opt/mpich/lib/pkgconfig:/opt/libfabric/lib/pkgconfig

#################################################################################
# Python

# Python and the packaging tools. The package name drops the dot of the release, e.g. 3.13 becomes python313.
ARG PYTHON_RELEASE=3.13
ARG PYTHON_PACKAGE=python313
RUN zypper --non-interactive install \
        $PYTHON_PACKAGE \
        $PYTHON_PACKAGE-devel \
        $PYTHON_PACKAGE-pip \
        $PYTHON_PACKAGE-packaging \
        $PYTHON_PACKAGE-wheel \
        $PYTHON_PACKAGE-setuptools

# Virtual environment that also sees the packages installed above
RUN python$PYTHON_RELEASE -m venv --system-site-packages /opt/venv

ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}

#################################################################################
# ROCm Validation Suite

RUN zypper --non-interactive install libpci3 libnuma1

WORKDIR /tmp/build/rvs
ARG RVS_RELEASE=1.5.125-620
ARG RVS_SHA256=8fb0c95d59ba1167758a8c4af8e2135b35a78ffab560dc3dffe2989ba57d7fba
RUN wget --output-document=rvs.tar.gz https://repo.amd.com/rocm/rvs/tarball/amdrocm7-rvs-$RVS_RELEASE-Linux.tar.gz
RUN echo "$RVS_SHA256  rvs.tar.gz" | sha256sum --check --strict
WORKDIR /opt/rocm/extras-7
RUN tar --extract --no-same-owner --file=/tmp/build/rvs/rvs.tar.gz
RUN echo /opt/rocm/extras-7/lib > /etc/ld.so.conf.d/rvs.conf && ldconfig
# RVS needs libomp.so from the ROCm LLVM
RUN echo /opt/rocm/core-$ROCM_RELEASE/lib/llvm/lib > /etc/ld.so.conf.d/rocm-llvm.conf && ldconfig

ENV PATH=/opt/rocm/extras-7/bin:${PATH}

#################################################################################
# OSU micro-benchmarks with ROCm and RCCL support

WORKDIR /tmp/build/osu-micro-benchmarks
ARG OSU_RELEASE=7.5.2
ARG OSU_SHA256=618de3d0b1122f73a9229177d2da1e5cd62e431190580cb915f2605849cbbbdc
RUN wget --output-document=osu-micro-benchmarks.tar.gz https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-$OSU_RELEASE.tar.gz
RUN echo "$OSU_SHA256  osu-micro-benchmarks.tar.gz" | sha256sum --check --strict
RUN tar --extract --no-same-owner --file=osu-micro-benchmarks.tar.gz --strip-components=1
# The xccl benchmarks declare function pointers as f() and call them with arguments, which C23 (the default of GCC 15) rejects.
RUN ./configure \
        CC=/opt/mpich/bin/mpicc \
        CXX=/opt/mpich/bin/mpicxx \
        CFLAGS="-std=gnu17 -g -O2" \
        CPPFLAGS="-D __HIP_PLATFORM_AMD__" \
        --prefix=/opt/osu \
        --enable-rocm \
        --with-rocm=/opt/rocm/core-$ROCM_RELEASE \
        --enable-rcclomb \
        --with-rccl=/opt/rocm/core-$ROCM_RELEASE
RUN make --jobs=$(nproc) install

ENV PATH=/opt/osu/libexec/osu-micro-benchmarks/mpi/pt2pt:/opt/osu/libexec/osu-micro-benchmarks/mpi/one-sided:/opt/osu/libexec/osu-micro-benchmarks/mpi/collective:/opt/osu/libexec/osu-micro-benchmarks/xccl/pt2pt:/opt/osu/libexec/osu-micro-benchmarks/xccl/collective:${PATH}

#################################################################################
# Clean

# Removes the files from the flattened SIF only. The earlier layers in the archive still contain them.
WORKDIR /
RUN rm -rf /tmp/build /tmp/keys
RUN zypper clean --all

ENTRYPOINT ["/bin/bash"]
