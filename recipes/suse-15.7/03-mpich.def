Bootstrap: localimage
From: {{ BASE_IMAGE }} # Builder must pass the base image with, e.g., `singularity build --build-arg BASE_IMAGE="$SINGULARITY_IMAGES/my-base-image.sif"`

%post
    set -euxo pipefail

    # Fetch package, check sha256sum, and extract
    # fetch_check_extract URL TO_FILE SHASUM
    fetch_check_extract() {
        wget --output-document="$2" "$1"
        echo "$3  $2" | sha256sum --check --strict
        tar --extract --file="$2"
    }
